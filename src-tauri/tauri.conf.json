{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chaves",
  "version": "0.3.0",
  "identifier": "app.chaves.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chaves",
        "theme": "Light",
        "backgroundColor": "#f4f1ea",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Chaves contributors",
    "copyright": "Chaves contributors",
    "category": "Utility",
    "shortDescription": "Local-first vault for API keys, links, and notes.",
    "longDescription": "Chaves is a local-first desktop vault for API keys, important links, and notes. The vault is encrypted with AES-256-GCM and a key derived with Argon2id. No account, no cloud, no telemetry."
  }
}
